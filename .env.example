# Optional: enables Claude-based match rubric and drafting. Without it, heuristics/templates are used.
ANTHROPIC_API_KEY=
# Where apply-pilot keeps its sqlite db, HTTP cache and packets (default: ./.apply-pilot)
APPLY_PILOT_HOME=
# Optional digest delivery (dry-run unless --send is passed)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
